# ── Required (startup fails fast if missing) ─────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_db

# Access-token signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production it must be >= 32 chars and must not contain "CHANGE-IN-PRODUCTION".
JWT_SECRET=

# ── Required in production only ───────────────────────────────────────────────

# Frontend URL for CORS whitelist (dev: Vite proxy handles it, prod: your deployed URL)
FRONTEND_URL=http://localhost:5173

# Directory for uploaded documents. MUST be outside the application directory
# in production (e.g. /var/lib/acctrack/uploads) so files survive redeploys.
# Dev default: <backend>/uploads
UPLOAD_DIR=

# ── Optional (validated as positive integers when set) ────────────────────────

# Server port (default: 3000)
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Auth tuning
ACCESS_TOKEN_EXPIRY_SECS=900
REFRESH_TOKEN_EXPIRY_SECS=604800
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
BCRYPT_ROUNDS=12

# Database pool tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
