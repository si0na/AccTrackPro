# ── Required (startup fails fast if missing) ─────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_db

# Access-token signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production it must be >= 32 chars and must not contain "CHANGE-IN-PRODUCTION".
JWT_SECRET=

# ── Required in production only ───────────────────────────────────────────────

# Frontend URL for CORS whitelist (dev: Vite proxy handles it, prod: your deployed URL)
FRONTEND_URL=http://localhost:5173

# Directory for uploaded documents. MUST be outside the application directory
# in production (e.g. /var/lib/acctrack/uploads) so files survive redeploys.
# Dev default: <backend>/uploads
UPLOAD_DIR=

# ── Optional (validated as positive integers when set) ────────────────────────

# Server port (default: 3000)
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Auth tuning
ACCESS_TOKEN_EXPIRY_SECS=900
REFRESH_TOKEN_EXPIRY_SECS=604800
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
BCRYPT_ROUNDS=12

# Database pool tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Stakeholder Connect MoM attachment limits (defaults: 15 MB per file, 50 MB total, 10 files/upload)
MOM_ATTACHMENT_MAX_FILE_SIZE_MB=15
MOM_ATTACHMENT_MAX_TOTAL_SIZE_MB=50
MOM_ATTACHMENT_MAX_FILES=10

# ── Microsoft Graph (Password Reset & Action Item Email Delivery) ─────────────
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# GRAPH_SENDER_EMAIL=noreply@reflectionsinfos.com

# ── Action Item Email Notification Safeguards ─────────────────────────────────
# Production notification eligibility cutoff date (YYYY-MM-DD). Action items created
# before this date or with due dates before this date will not send email notifications.
# Default: 2026-11-24
ACTION_ITEM_NOTIFICATION_CUTOFF_DATE=2026-11-24

