# Backend API URL — only needed in production builds.
# In development, Vite proxies /api to http://localhost:3000 automatically.
VITE_API_URL=

# App title (optional, used in document.title)
VITE_APP_TITLE=ReflectOne CRM

# Microsoft Entra ID Configuration (Single Page Application - Public Client)
# Note: Use the SPA Application (Client) ID with PKCE, NOT the confidential Web client ID.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# SPA Redirect URI (must match URI registered in Entra with trailing slash)
VITE_AZURE_REDIRECT_URI=http://localhost:5173/

# Microsoft Graph Delegated Scope for Employee Directory
VITE_GRAPH_SCOPES=https://graph.microsoft.com/User.ReadBasic.All
